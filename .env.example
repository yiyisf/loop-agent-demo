# ---- Server ----
PORT=3001
# Bind address (IPv4 loopback on every OS). Use 0.0.0.0 in Docker.
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Persist threads / runs / events to a local SQLite file (kept across restarts).
DATABASE_URL=file:./data/loop-agent.db
# Only `memory` is ephemeral — sessions disappear when the process exits:
# DATABASE_URL=memory
# Workspace for tool artifacts (per-run subdirectories). Not the session database.
DATA_DIR=./data
# Serve the built web app (apps/web/dist) from the API server on the same origin
STATIC_DIR=
# Emit AI SDK telemetry spans (requires an OpenTelemetry SDK/exporter in-process)
OTEL_ENABLED=false

# ---- LLM ----
# openai | openai-compatible | anthropic | mock
# Lite / internal gateways: openai-compatible (or openai) + LLM_BASE_URL to /v1
# (chat completions). Planner JSON is parsed locally; do not rely on json_schema.
LLM_PROVIDER=mock
# Slow down mock model calls (ms) to watch the run unfold in the UI
MOCK_DELAY_MS=0
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1
# Extra models offered in the UI model picker (comma separated)
LLM_MODELS=
# Optional per-role overrides
LLM_PLANNER_MODEL=
LLM_EXECUTOR_MODEL=

# ---- Tools ----
# tavily | exa | brave | none
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# ---- Budget ----
BUDGET_MAX_REPLANS=3
BUDGET_MAX_PARALLEL=2
BUDGET_MAX_DURATION_MS=900000
BUDGET_MAX_STEPS=12
BUDGET_MAX_TOTAL_TOKENS=300000
# Consult the LLM reflector after every successful step as well. Default false:
# confident successes use a rule-based shortcut; failures and summaries with
# uncertainty signals always go to the model.
REFLECT_ON_SUCCESS=false
