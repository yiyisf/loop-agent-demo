# ---- Server ----
PORT=3001
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# libsql URL; `memory` keeps threads/runs in-process (lost on restart)
DATABASE_URL=file:./data/loop-agent.db

# ---- LLM ----
# openai | openai-compatible | anthropic | mock
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1
# Optional per-role overrides
LLM_PLANNER_MODEL=
LLM_EXECUTOR_MODEL=

# ---- Tools ----
# tavily | exa | brave | none
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# ---- Budget ----
BUDGET_MAX_REPLANS=3
BUDGET_MAX_PARALLEL=2
BUDGET_MAX_DURATION_MS=900000
BUDGET_MAX_STEPS=12
BUDGET_MAX_TOTAL_TOKENS=300000
# Run the reflector after every successful step too (false = only after failures)
REFLECT_ON_SUCCESS=true
